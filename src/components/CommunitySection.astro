---
import { formatDate } from "../utils/locale";

interface NewsItem {
	id: string;
	title: string;
	publishedAt: Date | null;
}

interface Props {
	featured?: { id: string; title: string } | null;
	news: NewsItem[];
}

const { featured, news } = Astro.props;
---

<section class="band community-band" aria-labelledby="community-heading">
	<div class="frame community__grid">
		<section class="community__col">
			<p class="eyebrow">Community</p>
			<h2 id="community-heading" class="community__title">
				Join the discussion
			</h2>
			<p class="community__text">
				Every post has a comment thread. Sign in, share what you built, and
				compare notes with other Malaysian geeks.
			</p>
			<span class="badge badge--live">
				<span class="badge__dot" aria-hidden="true"></span>
				Comments open
			</span>
			{featured && (
				<a href={`/posts/${featured.id}#comments`} class="btn btn--sm community__cta">
					Read &amp; comment
				</a>
			)}
		</section>

		<section class="community__col">
			<p class="eyebrow">Random news</p>
			<h2 class="community__title">Fresh from the bench</h2>
			<ul class="community__list">
				{news.map((item) => (
					<li>
						<a href={`/posts/${item.id}`}>{item.title}</a>
						{item.publishedAt && (
							<time datetime={item.publishedAt.toISOString()}>
								{formatDate(item.publishedAt, "short")}
							</time>
						)}
					</li>
				))}
			</ul>
		</section>

		<section class="community__col">
			<p class="eyebrow">Geeky info</p>
			<h2 class="community__title">Stay in the loop</h2>
			<ul class="community__list community__links">
				<li><a href="/pages/about">About us</a></li>
				<li><a href="/pages/contact">Contact us</a></li>
				<li><a href="/pages/privacy">Privacy policy</a></li>
				<li><a href="/pages/terms">Terms of service</a></li>
			</ul>
			<form class="newsletter" data-newsletter>
				<label class="eyebrow newsletter__label" for="newsletter-email">
					Stay updated
				</label>
				<div class="newsletter__row">
					<input
						id="newsletter-email"
						class="newsletter__input"
						type="email"
						name="email"
						required
						placeholder="Email address"
						autocomplete="email"
					/>
					<button type="submit" class="btn btn--sm newsletter__submit">
						Subscribe
					</button>
				</div>
				<p class="newsletter__note" data-newsletter-note>
					No spam. Just new posts.
				</p>
			</form>
		</section>
	</div>
</section>

<style>
	.community-band {
		padding-block: clamp(2.5rem, 1.75rem + 2.5vw, 4rem);
	}

	.community__grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: var(--spacing-6);
	}

	.community__col {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-3);
		min-width: 0;
		overflow: hidden;
		padding: var(--spacing-6);
		border-radius: var(--radius-xl);
		background: var(--color-surface);
		box-shadow: var(--shadow-card);
	}

	.community__title {
		font-size: var(--font-size-xl);
	}

	.community__text {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.badge {
		display: inline-flex;
		align-items: center;
		gap: var(--spacing-2);
		padding: 2px 10px;
		border-radius: var(--radius-full);
		font-family: var(--font-mono);
		font-size: var(--font-size-label);
		letter-spacing: var(--tracking-wide);
		text-transform: uppercase;
	}

	.badge--live {
		background: var(--color-accent-soft);
		color: var(--color-accent);
	}

	.badge__dot {
		width: 6px;
		height: 6px;
		border-radius: var(--radius-full);
		background: currentColor;
	}

	.community__cta {
		margin-top: var(--spacing-1);
	}

	.community__list {
		display: grid;
		gap: var(--spacing-3);
		min-width: 0;
		list-style: none;
		font-size: var(--font-size-sm);
	}

	.community__list li {
		display: grid;
		gap: 2px;
	}

	.community__list a {
		color: var(--color-text);
		text-decoration-line: underline;
		text-decoration-thickness: 1px;
		text-decoration-color: transparent;
		text-underline-offset: 0.18em;
		overflow-wrap: anywhere;
		transition:
			color var(--transition-fast),
			text-decoration-color var(--transition-fast);
	}

	.community__list a:hover {
		color: var(--color-brand);
		text-decoration-color: currentColor;
	}

	.community__list time {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.community__links a {
		color: var(--color-text-secondary);
	}

	.newsletter {
		display: grid;
		gap: var(--spacing-2);
		width: 100%;
		min-width: 0;
		max-width: 100%;
		margin-top: var(--spacing-2);
	}

	.newsletter__row {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	.newsletter__input {
		flex: 1 1 9rem;
		min-width: 0;
		height: 36px;
		padding-inline: var(--spacing-3);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-full);
		background: var(--color-bg);
		color: var(--color-text);
		font: inherit;
		font-size: var(--font-size-sm);
	}

	.newsletter__input::placeholder {
		color: var(--color-muted);
	}

	.newsletter__input:focus {
		outline: 2px solid transparent;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.newsletter__note {
		font-size: var(--font-size-xs);
		color: var(--color-muted);
	}

	.newsletter__submit {
		flex-shrink: 0;
	}

	@media (max-width: 900px) {
		.community__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.community__col:first-child {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 560px) {
		.community__grid {
			grid-template-columns: minmax(0, 1fr);
		}

		.community__col:first-child {
			grid-column: auto;
		}

		.newsletter__row {
			flex-direction: column;
		}

		.newsletter__submit {
			width: 100%;
		}
	}
</style>

<script>
	document
		.querySelectorAll<HTMLFormElement>("[data-newsletter]")
		.forEach((form) => {
			form.addEventListener("submit", (event) => {
				event.preventDefault();
				const note = form.querySelector<HTMLElement>(
					"[data-newsletter-note]",
				);
				if (note) note.textContent = "Thanks! Newsletter signup is coming soon.";
				form.reset();
			});
		});
</script>
