---
import type { ContentEntry, InferCollectionData } from "emdash";
import { Image } from "emdash/ui";
import { formatDate } from "../utils/locale";

interface Props {
	post: ContentEntry<InferCollectionData<"posts">>;
	category?: { slug: string; label: string } | null;
	variant?: "main" | "side";
}

const { post, category = null, variant = "side" } = Astro.props;

const href = `/posts/${post.id}`;
const title = post.data.title || "Untitled";
const publishedAt = post.data.publishedAt ?? null;
const Heading = variant === "main" ? "h3" : "h4";
const sizes =
	variant === "main"
		? "(min-width: 1000px) 620px, 90vw"
		: "(min-width: 1000px) 300px, (min-width: 769px) 50vw, 90vw";
---

<article class:list={["featured-card", `featured-card--${variant}`]}>
	<a href={href} class="featured-card__link">
		<div class="featured-card__media">
			{
				post.data.featured_image ? (
					<Image
						image={post.data.featured_image}
						sizes={sizes}
						priority={variant === "main"}
					/>
				) : (
					<div class="featured-card__placeholder" />
				)
			}
		</div>
		<div class="featured-card__body">
			{category && <span class="featured-card__category">{category.label}</span>}
			<Heading class="featured-card__title">{title}</Heading>
			{publishedAt && (
				<time
					class="featured-card__date"
					datetime={publishedAt.toISOString()}
				>
					{formatDate(publishedAt, "short")}
				</time>
			)}
			{
				post.data.excerpt && (
					<p class="featured-card__excerpt">{post.data.excerpt}</p>
				)
			}
		</div>
	</a>
</article>

<style>
	.featured-card {
		position: relative;
		height: 100%;
		min-height: 0;
		overflow: hidden;
		border-radius: var(--radius-xl);
		background: var(--color-fill);
		box-shadow: var(--shadow-card);
		transition:
			box-shadow var(--transition-base),
			translate var(--transition-base);
	}

	.featured-card:hover,
	.featured-card:focus-within {
		box-shadow: var(--shadow-card-hover);
		translate: 0 -6px;
	}

	.featured-card__link {
		position: absolute;
		inset: 0;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		color: #fff;
		text-decoration: none;
	}

	.featured-card__media {
		position: absolute;
		inset: 0;
		z-index: 0;
		overflow: hidden;
	}

	.featured-card__media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: scale 600ms var(--ease-out);
	}

	.featured-card:hover .featured-card__media :global(img) {
		scale: 1.04;
	}

	.featured-card__placeholder {
		position: absolute;
		inset: 0;
		background-image: radial-gradient(
			circle,
			var(--color-border-strong) 1px,
			transparent 1.5px
		);
		background-size: 14px 14px;
		mask-image: radial-gradient(ellipse at center, #000 20%, transparent 75%);
	}

	.featured-card__body {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: var(--spacing-2);
		padding: var(--spacing-5);
		background: linear-gradient(
			to top,
			rgb(5 5 5 / 0.94) 0%,
			rgb(5 5 5 / 0.68) 55%,
			rgb(5 5 5 / 0) 100%
		);
	}

	.featured-card__category {
		font-family: var(--font-mono);
		font-size: var(--font-size-label);
		font-weight: 500;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: #e9b6f5;
	}

	.featured-card__title {
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: var(--font-size-lg);
		line-height: var(--leading-snug);
		color: #fff;
	}

	.featured-card--main .featured-card__title {
		-webkit-line-clamp: 3;
		font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
		line-height: var(--leading-tight);
		text-wrap: balance;
	}

	.featured-card__date {
		font-size: var(--font-size-xs);
		color: rgb(255 255 255 / 0.7);
		font-variant-numeric: tabular-nums;
	}

	.featured-card__excerpt {
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
		font-size: var(--font-size-sm);
		line-height: var(--leading-normal);
		color: rgb(255 255 255 / 0.82);
	}

	@media (min-width: 769px) {
		.featured-card--side .featured-card__excerpt {
			display: none;
		}
	}

	@media (max-width: 768px) {
		.featured-card__title {
			font-size: clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem);
			line-height: var(--leading-tight);
			-webkit-line-clamp: 3;
		}

		.featured-card__excerpt {
			-webkit-line-clamp: 2;
		}
	}
</style>
