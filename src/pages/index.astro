---
import {
	getEmDashCollection,
	getTermsForEntries,
	getSiteSettings,
	getTaxonomyTermsWithCacheHint,
} from "emdash";
import Base from "../layouts/Base.astro";
import FeaturedGrid from "../components/FeaturedGrid.astro";
import HomeFeed from "../components/HomeFeed.astro";
import { resolveBlogSiteIdentity } from "../utils/site-identity";

const HERO_LIMIT = 12;
const FEED_LIMIT = 5;
const SCAN_LIMIT = 60;

const [
	{ entries: posts, cacheHint, nextCursor },
	settings,
	tagTermsResult,
	categoryTermsResult,
] = await Promise.all([
	getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: SCAN_LIMIT,
	}),
	getSiteSettings(),
	getTaxonomyTermsWithCacheHint("tag", { includeCounts: true }),
	getTaxonomyTermsWithCacheHint("category", { includeCounts: true }),
]);

if (Astro.cache?.enabled) {
	Astro.cache.set(cacheHint);
	Astro.cache.set(tagTermsResult.cacheHint);
	Astro.cache.set(categoryTermsResult.cacheHint);
}

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

type Post = (typeof posts)[number];

// `featured` is a boolean field, which the collection filter does not accept,
// so select the curated posts here. Scanning the latest page keeps the
// homepage to a single content query while preserving newest-first order.
const isFeatured = (post: Post) =>
	(post.data as { featured?: boolean }).featured === true;

// Walk back through the archive until enough featured posts are found, so a
// curated older story is never hidden behind the latest-page window.
const featuredPool: Post[] = posts.filter(isFeatured);
let featuredCursor = nextCursor;
while (featuredCursor && featuredPool.length < HERO_LIMIT) {
	const page = await getEmDashCollection("posts", {
		orderBy: { published_at: "desc" },
		limit: SCAN_LIMIT,
		cursor: featuredCursor,
	});
	if (Astro.cache?.enabled) Astro.cache.set(page.cacheHint);
	featuredPool.push(...page.entries.filter(isFeatured));
	featuredCursor = page.nextCursor;
}
const heroPosts = featuredPool.slice(0, HERO_LIMIT);

// One batched query per taxonomy across every post on the page.
const postIds = [
	...new Set([...heroPosts, ...posts].map((post) => post.data.id)),
];
const [tagsByEntry, categoriesByEntry] = await Promise.all([
	getTermsForEntries("posts", postIds, "tag"),
	getTermsForEntries("posts", postIds, "category"),
]);

const categoryFor = (post: Post) => {
	const first = (categoriesByEntry.get(post.data.id) ?? [])[0];
	return first ? { slug: first.slug, label: first.label } : null;
};

const tagsFor = (post: Post) =>
	(tagsByEntry.get(post.data.id) ?? []).map((term) => ({
		slug: term.slug,
		label: term.label,
	}));

const heroItems = heroPosts.map((post) => ({
	post,
	category: categoryFor(post),
}));

const feedItems = posts.slice(0, FEED_LIMIT).map((post) => ({
	post,
	tags: tagsFor(post),
	category: categoryFor(post),
}));

const publishedTime = (post: Post) =>
	post.data.publishedAt ? new Date(post.data.publishedAt).getTime() : 0;

// Visual-only "trending": rank by tag count, then recency.
const trendingItems = [...feedItems].sort(
	(a, b) =>
		b.tags.length - a.tags.length ||
		publishedTime(b.post) - publishedTime(a.post),
);
const latestItems = feedItems;

const tagCount = (term: { count?: number }) => term.count ?? 0;
const sidebarTags = [...tagTermsResult.data]
	.sort((a, b) => tagCount(b) - tagCount(a))
	.slice(0, 10)
	.map((term) => ({ slug: term.slug, label: term.label }));

const sidebarCategories = categoryTermsResult.data
	.slice(0, 6)
	.map((term) => ({ slug: term.slug, label: term.label }));

---

<Base title={siteTitle} description={siteTagline}>
	<header class="band masthead">
		<div class="frame masthead__inner">
			<div class="masthead__text">
				<p class="eyebrow">Malaysian tech, documented</p>
				{siteTagline && <p class="masthead__tagline">{siteTagline}</p>}
			</div>
			<a href="/rss.xml" class="btn btn--ghost btn--sm">
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M4 11a9 9 0 0 1 9 9"></path>
					<path d="M4 4a16 16 0 0 1 16 16"></path>
					<circle cx="5" cy="19" r="1"></circle>
				</svg>
				RSS feed
			</a>
		</div>
	</header>

	{
		posts.length === 0 ? (
			<section class="band section">
				<div class="frame">
					<div class="empty-state">
						<h2 class="empty-state__title">No posts yet</h2>
						<p class="empty-state__text">
							Create your first post in the admin panel.
						</p>
						<div class="empty-state__actions">
							<a href="/_emdash/admin/content/posts/new" class="btn">
								Create a post
							</a>
						</div>
					</div>
				</div>
			</section>
		) : (
			<>
				<FeaturedGrid items={heroItems} />

				<HomeFeed
					trending={trendingItems}
					latest={latestItems}
					popular={trendingItems.slice(0, 3)}
					tags={sidebarTags}
					categories={sidebarCategories}
				/>
			</>
		)
	}
</Base>

<style>
	.masthead {
		padding-block: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
	}

	.masthead__inner {
		display: flex;
		flex-wrap: wrap;
		align-items: flex-end;
		justify-content: space-between;
		gap: var(--spacing-4) var(--spacing-8);
	}

	.masthead__text {
		min-width: 0;
	}

	.masthead__tagline {
		margin-top: var(--spacing-2);
		max-width: 26ch;
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 1.15rem + 1.5vw, 2.5rem);
		font-weight: var(--font-weight-display);
		line-height: var(--leading-tight);
		letter-spacing: var(--tracking-tight);
		color: var(--color-text);
		text-wrap: balance;
	}

	@media (max-width: 640px) {
		.masthead__inner {
			align-items: flex-start;
		}
	}
</style>

